+fn print_host_lines() {
+    let status = std::fs::read_to_string("/proc/self/status").ok();
+    let cpus = status
+        .as_deref()
+        .and_then(|text| text.lines().find(|line| line.starts_with("Cpus_allowed_list:")))
+        .map(|line| line["Cpus_allowed_list:".len()..].trim().to_string());
