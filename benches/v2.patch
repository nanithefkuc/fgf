+        Some(0) => "normal",
+        Some(1) => "fifo",
+        Some(2) => "rr",
+        Some(3) => "batch",
+        Some(5) => "idle",
+        Some(6) => "deadline",
+        Some(_) => "unknown",
+        None => "unavailable",
+    };
+    println!(
+        "HOST\tcpus_allowed_list={}\tsched_policy={} {policy_name}",
+        cpus.as_deref().unwrap_or("unavailable"),
+        policy.map_or("n/a".to_string(), |p| p.to_string()),
+    );
+}
