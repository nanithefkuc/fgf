+/// never drops below the helper's historical fixed batch.
+fn batch_reps(est_ns: f64, min_reps: u64) -> u64 {
+    ((BATCH_TARGET_NS / est_ns.max(1.0)).ceil() as u64).clamp(min_reps, MAX_BATCH_REPS)
